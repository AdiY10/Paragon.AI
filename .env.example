# Supply real values through the deployment secret store, never commit them.
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
DATABASE_URL=
CSRF_TRUSTED_ORIGINS=
# Set only behind an ingress that sanitizes forwarded headers.
TRUST_PROXY_SSL_HEADER=false
SEC_USER_AGENT=
CENSUS_API_KEY=
BLS_API_KEY=
OIDC_SERVER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
INITIAL_ADMIN_EMAIL=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# Optional OSM-compatible raster URL; blank disables external basemap requests.
# Only public endpoints / publishable tokens belong in this browser-visible setting.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Full Django backend: private durable mounted source evidence storage.
SOURCE_ARTIFACT_ROOT=
# Adi's temporary regular-host access mode; named accounts are provisioned privately.
PASSWORD_ACCESS_ENABLED=false

# One-time named administrator bootstrap for a regular host. Use the host secret
# store, remove both after verified login, then rotate with set_access_password.
ACCESS_BOOTSTRAP_EMAIL=
ACCESS_BOOTSTRAP_PASSWORD=
# Optional private migration file; both values are required together.
WORKSPACE_IMPORT_PATH=
WORKSPACE_IMPORT_SHA256=
